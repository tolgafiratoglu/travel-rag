# Travel RAG — project config (copy to .env in repo root)
# Secrets (API keys) live in ~/.config/rag/.env — see README.md

# --- LLM provider ---
# gemini = Google Gemini API (cloud)
# qwen   = local Qwen via Ollama (offline dev)
LLM_PROVIDER=qwen

# Gemini generation model (when LLM_PROVIDER=gemini)
GEMINI_MODEL=gemini-2.5-flash-lite

# Path to secrets file (GEMINI_API_KEY). Expanded at runtime (~ supported).
SECRETS_ENV_PATH=~/.config/rag/.env

# --- Qwen (generation when LLM_PROVIDER=qwen) ---
# Active size: 1b (QWEN1B) or 8b (QWEN8B)
QWEN_LLM=1b
QWEN8B=qwen3:8b
QWEN1B=qwen3:1.7b-q4_K_M

# --- Ollama runtime (embeddings always; Qwen inference when LLM_PROVIDER=qwen) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_GUARD_MODEL=sileader/qwen3guard:0.6b

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=travel_chunks
QDRANT_COLLECTION_MUSEUMS=travel_museums
QDRANT_COLLECTION_HISTORICAL=travel_historical_sites
# Required for docker-compose.prod.yml (generate: openssl rand -hex 32).
# API gets READ_ONLY; ingest/eval use ADMIN via QDRANT_API_KEY=...
# QDRANT_ADMIN_API_KEY=
# QDRANT_READ_ONLY_API_KEY=
# Host ingest against secured Qdrant:
# QDRANT_API_KEY=<same as QDRANT_ADMIN_API_KEY>

# --- Neo4j ---
# Use a strong unique password in production (not changeme).
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- MariaDB (ingest staging: wp_pages, wp_pois, …) ---
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=travel
MARIADB_USER=travel
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme

# Optional image pins (defaults in docker-compose*.yml)
# OLLAMA_IMAGE=ollama/ollama:0.9.6
# QDRANT_IMAGE=qdrant/qdrant:v1.13.2
# NEO4J_IMAGE=neo4j:5.26-community
# MARIADB_IMAGE=mariadb:11.4

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# --- Rate limit (in-memory, per client IP) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BURST=5
RATE_LIMIT_BURST_WINDOW_SECONDS=60
RATE_LIMIT_HOURLY=30
