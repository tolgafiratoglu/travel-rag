# Travel RAG — project config (copy to .env in repo root)
# Secrets (API keys) live in ~/.config/rag/.env — see README.md

# --- LLM provider ---
# gemini = Google Gemini API (default, cloud)
# ollama = local Qwen via Ollama (fallback / offline dev)
LLM_PROVIDER=gemini

# Gemini generation model (when LLM_PROVIDER=gemini)
GEMINI_MODEL=gemini-2.5-flash-lite

# Path to secrets file (GEMINI_API_KEY). Expanded at runtime (~ supported).
SECRETS_ENV_PATH=~/.config/rag/.env

# --- Ollama (embeddings always; generation when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=travel_chunks

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
